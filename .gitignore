# Byte-compiled / optimized / ambient files
__pycache__/
*.py[cod]
*$py.class

# Packaging and builds
*.egg-info/
dist/
build/

# Virtual environments
.venv/
venv/
env/

# Tool and testing caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# IDE and OS artifacts
.DS_Store
.vscode/
.idea/

# Environment and local secrets
.env
.env.*
!.env.example

# Logs and runtime diagnostics
*.log

# Generated models and experimental results (preserve repository anchors)
models/*
!models/.gitkeep
results/*
!results/.gitkeep
